     "text": [
      "D = \n",
      " [[ 3.  0.  0.]\n",
      " [ 0.  5.  0.]\n",
      " [ 0.  0. 12.]]\n",
      "L = \n",
      " [[-0. -0. -0.]\n",
      " [ 3. -0. -0.]\n",
      " [-6. -5. -0.]]\n",
      "U = \n",
      " [[-0. -2. -0.]\n",
