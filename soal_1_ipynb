   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "A = np.array([[3, 2, 0],\n",
    "              [-3, 5, -1],\n",
    "              [6, 5, 12]], dtype=float)\n",
    "\n",
    "b = np.array([[-7], [9], [47]], dtype=float)\n",
    "\n",
    "x0 = np.zeros((3, 1))\n",
    "\n",
    "tol = 1e-5\n",
    "N = 100\n",
    "\n",
    "print('A = \\n', A)\n",
    "print('b = \\n', b)\n",
    "print('x0 = \\n', x0)\n",
    "print('Tolerance = ', tol)\n",
    "print('Number of Iterations = ', N)"
   ]
  },
