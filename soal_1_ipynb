   "metadata": {},
   "source": [
    "### Metode 2: Jacobi Iteration\n",
    "\n",
    "Dekomposisi matriks:\n",
    "\n",
    "$$\n",
    "A=D-L-U\n",
    "$$\n",
    "\n",
    "Rumus iterasi:\n",
    "\n",
    "$$\n",
    "x^{(k+1)}=Tx^{(k)}+c\n",
    "$$\n",
    "\n",
    "$$\n",
    "T=D^{-1}(L+U)\n",
    "$$\n",
    "\n",
    "$$\n",
    "c=D^{-1}b\n",
    "$$\n"
   ]
  },
