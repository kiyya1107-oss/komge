    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "D = \n",
      " [[ 3.  0.  0.]\n",
      " [ 0.  5.  0.]\n",
      " [ 0.  0. 12.]]\n",
      "L = \n",
      " [[-0. -0. -0.]\n",
      " [ 3. -0. -0.]\n",
      " [-6. -5. -0.]]\n",
      "U = \n",
      " [[-0. -2. -0.]\n",
      " [-0. -0.  1.]\n",
      " [-0. -0. -0.]]\n"
     ]
    }
   ],
   "source": [
    "#A Decomposition\n",
    "D = np.diag(np.diag(A))\n",
    "L = -np.tril(A, -1)\n",
    "U = -np.triu(A, 1)\n",
    "\n",
    "print('D = \\n', D)\n",
    "print('L = \\n', L)\n",
    "print('U = \\n', U)"
   ]
