   ],
   "source": [
    "#calculate T and C\n",
    "D_inv = np.linalg.inv(D)\n",
    "\n",
    "T = D_inv @ (L + U)\n",
    "c = D_inv @ b\n",
    "\n",
    "print('T = \\n', T)\n",
    "print('c = \\n', c)"
   ]
